# =====================================================================================
#  SECRETS DE LA PASSERELLE WHATSAPP
#
#  Copiez ce fichier en `evolution/.env` et remplissez-le. Le vrai fichier est
#  couvert par `.gitignore` et n'entre JAMAIS dans Git : prévoyez explicitement
#  son transport lors d'un déménagement de poste.
#
#  Générer une valeur aléatoire (PowerShell) :
#      -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Max 256) })
#
#  ─── SI VOUS AVEZ DÉJÀ UNE PASSERELLE POUR UN AUTRE PROJET ──────────────────────
#
#  Une seule valeur se REPREND telle quelle, les autres doivent être neuves. La
#  distinction n'est pas cosmétique : deux d'entre elles cassent en silence.
#
#    ┌─────────────────────────┬────────────┬──────────────────────────────────┐
#    │ TAILSCALE_AUTHKEY       │ RÉUTILISER │ c'est le sens de « Reusable » :   │
#    │                         │            │ une clé vaut pour tous les nœuds │
#    │                         │            │ d'un même tailnet                │
#    ├─────────────────────────┼────────────┼──────────────────────────────────┤
#    │ TAILSCALE_HOSTNAME      │  NOUVEAU   │ ⚠️ LE PIÈGE. Tailscale n'attribue │
#    │                         │            │ jamais deux fois le même nom : le │
#    │                         │            │ nœud devient `<nom>-1`, l'adresse │
#    │                         │            │ publique n'est plus celle qu'on   │
#    │                         │            │ a déclarée, et RIEN ne le signale │
#    ├─────────────────────────┼────────────┼──────────────────────────────────┤
#    │ TUNNEL_PUBLIC_URL       │  NOUVEAU   │ elle découle du nom de nœud       │
#    ├─────────────────────────┼────────────┼──────────────────────────────────┤
#    │ EVOLUTION_API_KEY       │  NOUVEAU   │ deux organisations ne partagent   │
#    │                         │            │ pas un secret                     │
#    ├─────────────────────────┼────────────┼──────────────────────────────────┤
#    │ POSTGRES_PASSWORD       │  NOUVEAU   │ nouveau volume, nouveau mot de    │
#    │                         │            │ passe                             │
#    └─────────────────────────┴────────────┴──────────────────────────────────┘
#
#  Ce qui ne figure PAS ici et doit aussi différer : le NUMÉRO WHATSAPP (une
#  instance lie un téléphone) et `EVOLUTION_INSTANCE` chez l'hébergeur.
#
#  Et si les deux piles tournent un jour sur le MÊME poste, deux réglages de
#  `docker-compose.funnel.yml` doivent différer : `name:` (il décide du nom des
#  VOLUMES, donc de la session WhatsApp elle-même) et le port publié.
# =====================================================================================

# ─── Tailscale ────────────────────────────────────────────────────────────────
# Settings → Keys → Generate auth key.
#   • cochée REUSABLE
#   • surtout PAS Ephemeral — un nœud éphémère est supprimé dès qu'il se
#     déconnecte et revient sous un nom différent, ce qui CHANGE l'adresse
#     publique et coupe l'application sans prévenir.
# Réutilisable telle quelle si vous en avez déjà une, non expirée.
TAILSCALE_AUTHKEY=tskey-auth-xxxxxxxxxxxx

# Le nom du nœud. Il ne se récupère nulle part : C'EST UN NOM QUE VOUS CHOISISSEZ.
# Il forme la première moitié de l'adresse publique, et DOIT être différent de
# celui de tout autre projet du même tailnet.
TAILSCALE_HOSTNAME=rclmc-wa

# L'adresse publique complète : https:// + TAILSCALE_HOSTNAME + . + nom du tailnet.
# Le nom du tailnet se lit dans la console Tailscale → DNS (ex. tail6ac334.ts.net)
# et reste le MÊME pour tous vos projets.
#
# SANS SLASH FINAL — cette valeur devient le `server_url` de chaque webhook, et
# l'application le compare au caractère près. Un slash en trop fait rejeter tous
# les accusés de remise en 403.
#
# Sur le poste de développement, elle sert AUSSI d'`EVOLUTION_BASE_URL` : une
# seule valeur à tenir juste au lieu de deux qui doivent rester égales.
TUNNEL_PUBLIC_URL=https://rclmc-wa.tailXXXXXX.ts.net

# ─── Passerelle Evolution ─────────────────────────────────────────────────────
# Doit valoir EXACTEMENT `EVOLUTION_API_KEY` côté application (chez l'hébergeur).
EVOLUTION_API_KEY=remplacez-par-32-octets-aleatoires

# Mot de passe de la base de la passerelle. Il n'apparaît nulle part ailleurs —
# surtout pas chez l'hébergeur.
# ⚠️ Il n'est appliqué qu'à l'INITIALISATION du volume Postgres. Le modifier
#    ensuite fait rejeter la connexion et la passerelle ne démarre plus.
POSTGRES_PASSWORD=remplacez-par-32-octets-aleatoires


